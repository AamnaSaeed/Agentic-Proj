# Environment, secrets, and local overrides
.env
.env.*
!.env.example
*.local

# Codex / assistant local workspace files
.codex
.codex/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.coverage
coverage.xml
htmlcov/

# Python virtual environments
.venv/
venv/
env/
ENV/

# Python packaging/build artifacts
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/

# Node / Vite / React
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Generated pipeline data
data/jobs/
data/outputs/
data/temp/
data/state_versions/

# Keep placeholder directories if present
!data/
!data/**/
!data/**/.gitkeep

# Generated media and binary assets
*.mp3
*.wav
*.m4a
*.aac
*.flac
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.srt

# Allow frontend/source assets if intentionally added later
!frontend/src/assets/
!frontend/src/assets/**/*
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.jpeg
!docs/**/*.webp

# Logs
*.log
logs/

# Docker/local runtime artifacts
.docker/
docker-data/

# IDE/editor files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Project scratch files
test.png
