# ── Google Gemini API ─────────────────────────────────────────────────────
# Get a free key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# ── Phase 1 settings ──────────────────────────────────────────────────────
# Model used by all three Phase 1 agent nodes.
# Options: gemini-2.0-flash      (fast, low cost)
#          gemini-1.5-pro        (higher quality)
#          gemini-2.0-flash-lite (cheapest)
PHASE1_MODEL=gemini-2.0-flash

# Directory where Phase 1 JSON artifacts are written.
# A timestamped sub-folder is created per run: data/outputs/phase1/YYYYMMDD_HHMMSS/
PHASE1_OUTPUT_DIR=data/outputs

# Phase 2 settings
# Defaults to the bundled Phase 1 sample handoff when not set.
PHASE2_HANDOFF_PATH=data/outputs/phase1/20260502_173240/phase2_audio_handoff.json
PHASE2_OUTPUT_DIR=data/outputs/phase2
# Optional: override the Edge neural voice used by all characters.
# Examples: en-US-JennyNeural, en-US-GuyNeural, en-US-AriaNeural
PHASE2_EDGE_TTS_VOICE=
